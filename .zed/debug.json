// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "CodeLLDB",
    "label": "Debug",
    "request": "launch",
    "name": "Debug",
    "program": "build/test",
    "args": [
      "test/script.seal"
    ],
    "env": {
      "SL_PRINT_BC": "true",
      "SL_PRINT_AST": "true"
    },
    "stopOnEntry": false,
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "adapter": "CodeLLDB",
    "label": "Release",
    "request": "launch",
    "name": "Release",
    "program": "build_release/test",
    "args": [
      "test/script.seal"
    ],
    "env": {
      "SL_PRINT_BC": "true",
      "SL_PRINT_AST": "true"
    },
    "stopOnEntry": false,
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
